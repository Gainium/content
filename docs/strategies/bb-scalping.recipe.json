{
  "strategy": "bb-scalping",
  "name": "BB%B scalping (blue chips)",
  "source": {
    "label": "Ares's BB Scalping Blue Chips bot, shared on the Gainium community forum (June 2024), from the High Sortino BB%B strategy",
    "url": "https://community.gainium.io/t/88/31"
  },
  "discussion": "https://community.gainium.io/t/88",
  "tuned": true,
  "rulesFixedAt": "2024-06-12",
  "oosFrom": "2024-06-12",
  "baseline": "random",
  "tags": [
    "mean-reversion",
    "scalping"
  ],
  "rules": [
    "On 15-minute candles, buy when Bollinger %B (27) is at or below its 10th percentile of the last 350 candles, price is at a pivot low, the daily TradingView rating is Buy and the moving-average ratio is above 0.95.",
    "Sell when Bollinger %B (23) is at or above its 90th percentile of the last 350 candles, with at least 0.1% profit.",
    "Take profit in the coin, not USDT.",
    "Hold one deal per coin at a time, with no stop loss."
  ],
  "notExpressed": [
    "The version with two deals per coin, posted beside it"
  ],
  "bot": {
    "type": "dca",
    "interval": "15m",
    "settings": {
      "baseOrderSize": "100",
      "startCondition": "TechnicalIndicators",
      "useTp": true,
      "tpPerc": "1",
      "dealCloseCondition": "techInd",
      "useMinTP": true,
      "minTp": "0.1",
      "profitCurrency": "base",
      "startOrderType": "LIMIT",
      "maxDealsPerPair": "1",
      "indicatorGroups": [
        {
          "id": "entry",
          "logic": "and",
          "action": "startDeal"
        },
        {
          "id": "exit",
          "logic": "and",
          "action": "closeDeal"
        }
      ],
      "indicators": [
        {
          "type": "BBPB",
