  "rules": [
    "Buy when the hourly close crosses above the upper Keltner channel (35-hour EMA, 3 times the 10-hour range) while price is above the 400-hour TEMA.",
    "Sell 3% above the entry, or at a 1.5% loss.",
    "Once the trade is 2% up, move the stop to 1.5% above the entry.",
    "Hold one position per coin at a time."
  ],
  "notExpressed": [],
  "bot": {
    "type": "dca",
    "interval": "1h",
    "settings": {
      "baseOrderSize": "1000",
      "startCondition": "TechnicalIndicators",
      "useTp": true,
      "tpPerc": "3",
      "useSl": true,
      "slPerc": "-1.5",
      "moveSL": true,
      "moveSLTrigger": "2",
      "moveSLValue": "1.5",
      "maxNumberOfOpenDeals": "3",
      "maxDealsPerPair": "1",
      "indicatorGroups": [
        {
          "id": "entry",
          "logic": "and",
          "action": "startDeal"
        }
      ],
      "indicators": [
