{
  "strategy": "ema-stack-fvg",
  "name": "EMA stack with fair value gap tap",
  "source": {
    "label": "The Unique High RR strategy (a forex and gold model on 30-minute candles), published in TradeZella's strategy library",
    "url": "https://www.tradezella.com/strategies/unique-high-rr"
  },
  "tuned": false,
  "rulesFixedAt": "2026-10-30",
  "baseline": "random",
  "tags": [
    "trend-following"
  ],
  "rules": [
    "Only buy while the hourly close is above the 200-hour EMA and the 5, 9, 13 and 21-hour EMAs are stacked in that order, fastest on top.",
    "Only buy while the last daily Heikin Ashi candle is green.",
    "Only buy between 03:00 and 06:30 New York time, Monday to Friday.",
    "Buy when price dips into the middle of the latest bullish fair value gap.",
    "Sell when the 5-hour EMA crosses below the 9-hour EMA, or at a 2% loss from the entry.",
    "Hold one position per coin at a time."
  ],
  "notExpressed": [
    "The 30-minute chart: the test runs hourly candles",
    "The trident pattern: a small doji wicking into the gap's midpoint, then a confirming candle",
    "Requiring the gap to form between 02:30 and 04:00 New York time",
    "The stop below the gap's first candle (a fixed 2% stands in for it), and the target managed from daily structure",
    "Closing early on a large candle that breaks the structure",
    "The daily candle-strength indicator: a daily Heikin Ashi colour stands in for it",
    "Short trades below the 200 EMA (the test is spot, long only)"
  ],
  "variants": [
    "regime:supertrend",
    "regime:structure",
    {
      "id": "any-hour",
      "name": "Any hour, every day (no session window)",
      "kind": "settings",
      "indicators": {
        "ny-window": {
          "sessionPreset": "allDay",
          "sessionStart": null,
          "sessionEnd": null,
          "sessionDays": [0, 1, 2, 3, 4, 5, 6]
        }
      }
    }
  ],
